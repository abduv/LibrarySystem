@model IEnumerable<LibraryApp.Models.Order>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var lang = Context.Session.GetString("Language") ?? "ru";
    var t_pending = lang == "kz" ? "Өңделуде" : "В обработке";
    var t_approved = lang == "kz" ? "Мақұлданды" : "Одобрено";
    var t_rejected = lang == "kz" ? "Бас тартылды" : "Отказано";
}

<div class="container mt-4">
    <h2 class="mb-4">@(lang == "kz" ? "Тапсырыстарды басқару" : "Управление заказами")</h2>
    
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-light">
                <tr>
                    <th>Пользователь</th>
                    <th>Книга</th>
                    <th>Дата</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model) {
                    <tr>
                        <td><strong>@item.UserLogin</strong></td>
                        <td>@item.Book?.Title</td>
                        <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (item.Status == "Pending") {
                                <span class="badge bg-warning text-dark px-3 py-2">@t_pending</span>
                            } else if (item.Status == "Approved") {
                                <span class="badge bg-success px-3 py-2">@t_approved</span>
                            } else {
                                <span class="badge bg-danger px-3 py-2">@t_rejected</span>
                            }
                        </td>
                        <td>
                            @if (item.Status == "Pending") {
                                <form asp-action="UpdateOrderStatus" method="post" class="d-inline">
                                    <input type="hidden" name="orderId" value="@item.Id" />
                                    <button name="status" value="Approved" class="btn btn-sm btn-success me-1">Одобрить</button>
                                    <button name="status" value="Rejected" class="btn btn-sm btn-danger">Отказать</button>
                                </form>
                            }
                            <form asp-action="DeleteOrder" method="post" class="d-inline ms-2">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button class="btn btn-sm btn-outline-secondary" onclick="return confirm('Удалить запись?')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>