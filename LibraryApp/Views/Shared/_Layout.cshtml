@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    var lang = Context.Session.GetString("Language") ?? "ru";
    
    // Переводы для Layout
    var t_menu = lang == "kz" ? "Мәзір" : "Меню";
    var t_admin_orders = lang == "kz" ? "Тапсырыстар" : "Заказы";
    var t_admin_books = lang == "kz" ? "Кітаптар" : "Книги";
    var t_login = lang == "kz" ? "Кіру" : "Войти";
    var t_logout = lang == "kz" ? "Шығу" : "Выйти";
    var t_reg = lang == "kz" ? "Тіркелу" : "Регистрация";
    var t_cats_title = lang == "kz" ? "Санаттар" : "Категории";
    
    var categoryKeys = new[] { "Художественная литература", "Литература Казахстана", "Детская литература", "Учебники и образование", "Наука и IT" };
    var categoryNames = lang == "kz"
        ? new[] { "Көркем әдебиет", "Қазақстан әдебиеті", "Балалар әдебиеті", "Оқулықтар", "Ғылым және IT" }
        : categoryKeys;
}

<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BOOK-INFO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/LibraryApp.styles.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-2">
        <div class="container">
            <button class="btn btn-primary me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
                <i class="bi bi-list"></i> @t_menu
            </button>
            <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">📚 BOOK-INFO</a>
            
            <div class="ms-auto d-flex align-items-center">
                @if (Context.Session.GetString("UserRole") == "Admin") {
                    <a class="nav-link text-danger fw-bold me-3" asp-controller="Book" asp-action="ManageOrders">@t_admin_orders</a>
                    <a class="nav-link text-primary fw-bold me-3" asp-controller="Book" asp-action="Index">@t_admin_books</a>
                }

                <div class="btn-group btn-group-sm me-3 shadow-sm">
                    <a href="@Url.Action("ChangeLanguage", "Home", new { culture = "ru" })" class="btn @(lang == "ru" ? "btn-primary" : "btn-outline-primary")">RU</a>
                    <a href="@Url.Action("ChangeLanguage", "Home", new { culture = "kz" })" class="btn @(lang == "kz" ? "btn-primary" : "btn-outline-primary")">KZ</a>
                </div>

                @if (Context.Session.GetString("UserName") != null) {
                    <span class="me-2 fw-bold text-secondary">@Context.Session.GetString("UserName")</span>
                    <a class="btn btn-sm btn-outline-danger rounded-pill px-3" asp-controller="Account" asp-action="Logout">@t_logout</a>
                } else {
                    <a class="nav-link text-dark me-2" asp-controller="Account" asp-action="Login">@t_login</a>
                    <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">@t_reg</a>
                }
            </div>
        </div>
    </nav>
</header>

<div class="offcanvas offcanvas-start" tabindex="-1" id="sidebarMenu">
    <div class="offcanvas-header bg-primary text-white">
        <h5 class="offcanvas-title">@t_cats_title</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        <div class="list-group list-group-flush">
            @for (int i = 0; i < categoryKeys.Length; i++) {
                <a asp-controller="Home" asp-action="Index" asp-route-category="@categoryKeys[i]" class="list-group-item list-group-item-action py-3">@categoryNames[i]</a>
            }
        </div>
    </div>
</div>

<div class="container mt-4">@RenderBody()</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>